# ── Core ──────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=8787

# ── Redis cache (24h TTL) ─────────────────────────────────
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=86400

# ── Confidence & matching ─────────────────────────────────
MIN_CONFIDENCE=50
AMBIGUOUS_CONFIDENCE=70

# ── Browser / anti-detection ──────────────────────────────
HEADLESS=true
BROWSER_TIMEOUT_MS=30000
ACTION_DELAY_MIN_MS=500
ACTION_DELAY_MAX_MS=2000
# Optional residential proxy (http://user:pass@host:port)
PROXY_URL=

# ── Rate limiting per supplier domain ─────────────────────
MAX_CONCURRENT_PER_DOMAIN=3
MIN_INTERVAL_MS=1000

# ── Pipeline ──────────────────────────────────────────────
PIPELINE_TIMEOUT_MS=15000
SUPPLIER_TIMEOUT_MS=12000
